import numpy as np

actions = [
    "Steer Left",
    "Keep Straight",
    "Steer Right"
]

policy = np.array([0.3, 0.5, 0.2])

learning_rate = 0.1

for episode in range(100):

    action = np.random.choice(
        3,
        p=policy
    )

    if action == 1:
        reward = 10
    else:
        reward = -2

    policy[action] += learning_rate * reward

    policy = np.maximum(policy, 0)
    policy = policy / policy.sum()

print("Lane Keeping Policy:")

for i in range(3):
    print(actions[i], round(policy[i], 3))

print("Best Action:",
      actions[np.argmax(policy)])
