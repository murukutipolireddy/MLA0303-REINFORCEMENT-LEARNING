import random

states = ["Room", "Kitchen", "Hall", "Goal"]
actions = ["Left", "Right"]

Q = {(s, a): 0 for s in states for a in actions}

alpha = 0.1
gamma = 0.9

for episode in range(100):
    state = "Room"

    while state != "Goal":
        action = random.choice(actions)

        if state == "Room":
            next_state = "Hall"
        elif state == "Hall":
            next_state = "Kitchen"
        else:
            next_state = "Goal"

        reward = 10 if next_state == "Goal" else -1

        Q[(state, action)] += alpha * (
            reward + gamma * max(
                Q[(next_state, a)] for a in actions
            ) - Q[(state, action)]
        )

        state = next_state

print("Learned Q-values:")
for key, value in Q.items():
    print(key, round(value, 2))
