import random

states = 5
actions = 2

alpha = 0.1
gamma = 0.9

# TD(0)
V = [0] * states

for episode in range(100):

    state = random.randint(0, states - 2)
    next_state = state + 1
    reward = 10 if next_state == states - 1 else -1

    V[state] += alpha * (
        reward + gamma * V[next_state] - V[state]
    )

print("TD(0) Values:")
print(V)


# SARSA
Q = [[0 for a in range(actions)] for s in range(states)]

for episode in range(100):

    state = 0
    action = random.randint(0, 1)

    for step in range(10):

        next_state = min(state + 1, states - 1)
        reward = 10 if next_state == states - 1 else -1

        next_action = random.randint(0, 1)

        Q[state][action] += alpha * (
            reward +
            gamma * Q[next_state][next_action]
            - Q[state][action]
        )

        state = next_state
        action = next_action

print("\nSARSA:")
print(Q)


# Q-Learning
Q = [[0 for a in range(actions)] for s in range(states)]

for episode in range(100):

    state = 0

    for step in range(10):

        action = random.randint(0, 1)

        next_state = min(state + 1, states - 1)

        reward = 10 if next_state == states - 1 else -1

        Q[state][action] += alpha * (
            reward +
            gamma * max(Q[next_state])
            - Q[state][action]
        )

        state = next_state

print("\nQ-Learning:")
print(Q)
